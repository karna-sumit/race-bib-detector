# Copy this file to .env and fill in your values
# detection/.env is gitignored — never commit the real .env

# Your tagger identifier for the photo API
TAGGER_ID=

# API endpoint to post detected bib numbers to
ADD_IMAGE_URL=

# URL template for fetching race images (used by detection pipeline)
# Use {album_name} and {image_id} as placeholders
GET_IMAGE_URL=

# Base URL for image hosting — used by training scripts to construct image URLs
# e.g. https://your-domain.se  (no trailing slash)
IMAGE_BASE_URL=

# API endpoints for training scripts (album discovery and image listing)
GET_ALBUMS_URL=
GET_IMAGE_LIST_URL=

# Inference device: cpu (default), mps (Apple Silicon), cuda (NVIDIA GPU)
DEVICE=cpu

# Number of concurrent worker threads (16 default, 32 on GCP e2-standard-4)
WORKERS=16
